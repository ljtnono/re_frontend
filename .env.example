# 环境变量模板：复制为 .env / .env.development / .env.production 后按需修改
# 注意：vue-cli 只有 VUE_APP_ 前缀的变量会注入前端代码，通过 process.env.VUE_APP_XXX 读取

# 后端网关地址
VUE_APP_API_BASE_URL=http://127.0.0.1:9100/api-frontend

# Artalk 评论系统服务地址
VUE_APP_ARTALK_SERVER=http://127.0.0.1:30610

# Artalk 评论系统的站点名
VUE_APP_ARTALK_SITE=re_frontend
